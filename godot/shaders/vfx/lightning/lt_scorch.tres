[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_73rju"]
parameter_name = "color_scorch"
default_value_enabled = true
default_value = Color(0.1, 0.12, 0.2, 1)

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_kq8pr"]
resource_name = "Scorch coverage"
size = Vector2(520, 360)
expression = "
vec2 p = (uv_in - vec2(0.5)) * 2.0;
float r = length(p);
float a = atan(p.y, p.x);
float edge = wave * (1.0 + 0.08 * (lt_noise(vec2(a * 6.0, seed)) - 0.5));
ring = (1.0 - smoothstep(0.0, 0.045, abs(r - edge))) * (1.0 - wave * 0.7);
// 셀 경계를 각도 방향으로 늘려 바깥으로 갈라지는 방전선
float cl = 1.0 - smoothstep(0.0, 0.05, lt_cell(vec2(a * 2.2 + seed, r * 6.0 - seed)));
float lane = abs(fract(a * 6.0 / 6.2831853 + lt_path(r * 1.5, seed) * 0.35) - 0.5);
float radial = smoothstep(0.46, 0.49, lane);
lines = max(cl * 0.6 * (1.0 - smoothstep(0.2, 0.7, r)), radial) * (1.0 - smoothstep(spread * 0.92 - 0.1, spread * 0.92, r)) * smoothstep(0.06, 0.14, r);
burn = (1.0 - smoothstep(0.15, 0.42, r + (lt_noise(p * 5.0 + seed) - 0.5) * 0.15)) * smoothstep(0.0, 0.3, spread);
"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_ctq8w"]
resource_name = "Scorch color"
size = Vector2(520, 360)
expression = "
vec3 hot = mix(c_hot.rgb * 1.8, vec3(1.0), lines * 0.35);
vec3 col = mix(c_scorch.rgb, mix(hot, c_scorch.rgb * 1.4, cool), lines);
col = mix(col, vec3(0.85, 1.0, 1.0) * 1.6, ring * (1.0 - cool));
color = col;
alpha = clamp(lines * (1.0 - cool * 0.45) + burn * 0.55 + ring * (1.0 - cool), 0.0, 1.0) * fade;
"

[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_vps03"]
resource_name = "Lightning noise / zigzag"
expression = "
float lt_hash(vec2 p) {
	p = fract(p * vec2(127.13, 311.71));
	p += dot(p, p + 41.7);
	return fract(p.x * p.y);
}
float lt_hash1(float x) {
	return lt_hash(vec2(x, x * 0.37 + 1.3));
}
float lt_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(lt_hash(i), lt_hash(i + vec2(1.0, 0.0)), f.x),
		mix(lt_hash(i + vec2(0.0, 1.0)), lt_hash(i + vec2(1.0, 1.0)), f.x), f.y);
}
// 선형 보간 1D 노이즈 — 꺾인 직선 마디(번개의 지그재그)
float lt_zig(float x, float s) {
	float i = floor(x);
	float f = fract(x);
	return mix(lt_hash1(i + s * 13.1), lt_hash1(i + 1.0 + s * 13.1), f);
}
// 세 옥타브 지그재그(-0.5~0.5 근처)
float lt_path(float x, float s) {
	return (lt_zig(x * 5.0, s) - 0.5) * 0.62 + (lt_zig(x * 15.0, s + 3.0) - 0.5) * 0.24 + (lt_zig(x * 41.0, s + 7.0) - 0.5) * 0.09;
}
// 셀 경계까지 거리(F2-F1) — 방전선
float lt_cell(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 o = vec2(lt_hash(i + g), lt_hash(i + g + 17.3));
			float d = length(g + o - f);
			if (d < d1) { d2 = d1; d1 = d; } else if (d < d2) { d2 = d; }
		}
	}
	return d2 - d1;
}
"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_hdvsx"]
input_name = "uv"

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_8kr53"]
parameter_name = "wave"
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_pu10n"]
parameter_name = "spread"
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_cjxgg"]
parameter_name = "cool"
default_value_enabled = true

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_k7hpa"]
parameter_name = "fade"
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_rryxx"]
parameter_name = "seed"
default_value_enabled = true

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_p8qb2"]
parameter_name = "color_hot"
default_value_enabled = true
default_value = Color(0.55, 0.95, 1, 1)

[resource]
resource_name = "Lightning / ground strike / discharge cracks + scorch"
modes/depth_draw = 2
modes/cull = 2
flags/unshaded = true
flags/shadows_disabled = true
