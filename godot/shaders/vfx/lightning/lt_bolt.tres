float bd = abs(y - boff);
branch = (1.0 - smoothstep(0.01, 0.024, bd)) * bmask * vis + exp(-bd * 55.0) * bmask * vis * 0.35;
// 뻗어 나가는 머리의 섬광
head = exp(-abs(x - reach) * 30.0) * exp(-d * 6.0) * step(x, reach + 0.03) * (1.0 - step(0.999, reach));
"
