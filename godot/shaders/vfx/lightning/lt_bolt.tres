hole = smoothstep(0.6, 0.68, hn) * smoothstep(0.08, 0.15, w) * (1.0 - smoothstep(w * 0.35, w * 0.6, d)) * core;
// 잔가지: 다른 씨앗의 가는 지그재그가 군데군데에서만 보인다
float boff = off + lt_path(x * 3.4, seed + 5.0) * 1.1 * pin;
