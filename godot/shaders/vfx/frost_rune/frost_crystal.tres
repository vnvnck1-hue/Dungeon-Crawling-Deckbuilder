[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_8yu7q"]
parameter_name = "color_light"
default_value_enabled = true
default_value = Color(0.55, 0.82, 1, 1)

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_wfri4"]
parameter_name = "color_rim"
default_value_enabled = true
default_value = Color(0.92, 0.98, 1, 1)

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_3woh8"]
resource_name = "Ice facets"
size = Vector2(520, 360)
expression = "
// uv.x = 면 번호 비율, uv.y = 높이(0 바닥 → 1 끝). 법선은 면마다 평평하다.
vec3 nn = normalize(n);
vec3 vv = normalize(v);
float lam = dot(nn, normalize(vec3(-0.45, 0.75, 0.5)));
float tone = smoothstep(-0.08, 0.02, lam) * 0.5 + smoothstep(0.5, 0.58, lam) * 0.5;
float fres = pow(1.0 - clamp(dot(nn, vv), 0.0, 1.0), 2.2);
vec3 col = mix(c_deep.rgb, c_light.rgb, clamp(uv_in.y * 0.45 + tone * 0.45, 0.0, 1.0));
// 안쪽 굴절 줄무늬
float streak = smoothstep(0.6, 0.68, fr_noise(vec2(uv_in.x * 11.0 + seed * 13.0, uv_in.y * 2.2 + seed)));
col += streak * vec3(0.16, 0.2, 0.24);
col = mix(col, c_rim.rgb, fres * 0.55);
col += smoothstep(0.82, 1.0, uv_in.y) * 0.22;
color = mix(col, vec3(1.0), flash);
"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_xi7du"]
resource_name = "Melt dissolve"
size = Vector2(520, 360)
expression = "
float nz = fr_fbm(vec2(uv_in.x * 6.0 + seed * 7.0, uv_in.y * 4.0 + seed));
float k = nz * 0.55 + (1.0 - uv_in.y) * 0.45;   // 끝(위)이 먼저 녹는다
float e = 1.0 - smoothstep(0.0, 0.07, k - melt);
color = mix(col_in, vec3(0.9, 0.97, 1.0) * 1.25, e * step(0.001, melt));
alpha = clamp(k - melt + 0.5, 0.0, 1.0);
scissor = 0.5;
"

[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_l241t"]
resource_name = "Frost noise / cells / segment"
expression = "
float fr_hash(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}
float fr_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(fr_hash(i), fr_hash(i + vec2(1.0, 0.0)), f.x),
		mix(fr_hash(i + vec2(0.0, 1.0)), fr_hash(i + vec2(1.0, 1.0)), f.x), f.y);
}
float fr_fbm(vec2 p) {
	float v = 0.0;
	float a = 0.5;
	for (int k = 0; k < 4; k++) {
		v += a * fr_noise(p);
		p = p * 2.03 + vec2(1.7, 9.2);
		a *= 0.5;
	}
	return v;
}
// 결정 세포: x = 가장 가까운 점까지 거리, y = 경계까지 거리(F2-F1), z = 세포 고유값
vec3 fr_cells(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	float id = 0.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 o = vec2(fr_hash(i + g), fr_hash(i + g + 19.7));
			float d = length(g + o - f);
			if (d < d1) {
				d2 = d1;
				d1 = d;
				id = fr_hash(i + g + 3.1);
			} else if (d < d2) {
				d2 = d;
			}
		}
	}
	return vec3(d1, d2 - d1, id);
}
float fr_seg(vec2 p, vec2 a, vec2 b) {
	vec2 pa = p - a;
	vec2 ba = b - a;
	float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * h);
}
"

