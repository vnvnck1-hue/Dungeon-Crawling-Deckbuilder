[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_nyxqm"]
parameter_name = "seed"
default_value_enabled = true

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_rfv04"]
parameter_name = "color_frost"
default_value_enabled = true
default_value = Color(0.62, 0.74, 1, 1)

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_pp5pr"]
parameter_name = "color_edge"
default_value_enabled = true
default_value = Color(0.95, 0.98, 1, 1)

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_5gsb5"]
resource_name = "Rime coverage"
size = Vector2(520, 360)
expression = "
vec2 p = (uv_in - vec2(0.5)) * 2.0 * ext;
float r = length(p);
float a = atan(p.y, p.x);
// 들쭉날쭉한 서리 앞머리
float jag = fr_fbm(vec2(cos(a), sin(a)) * 2.2 + seed * 7.0);
float spike = pow(abs(sin(a * 11.0 + seed * 5.0)), 18.0) * 0.08;
float front = spread * (0.8 + 0.3 * jag + spike);
float wob = (fr_fbm(p * 3.0 + seed * 11.0) - 0.5) * 0.16;
float body = 1.0 - smoothstep(front - 0.04, front, r + wob);
// 결정 세포
vec3 c = fr_cells(p * cells_n + seed * 13.0);
crack = 1.0 - smoothstep(0.0, 0.07, c.y);
facet = c.z;
rim = smoothstep(front - 0.28, front - 0.02, r + wob) * body;
// 바깥과 성긴 부분부터 녹는다
float m = fr_fbm(p * 2.2 + seed * 5.0 + 3.0) * 0.72 + (1.0 - clamp(r / ext, 0.0, 1.0)) * 0.28;
float alive = smoothstep(melt, melt + 0.06, m);
wet = alive * (1.0 - smoothstep(melt + 0.06, melt + 0.13, m)) * step(0.001, melt);
cover = body * alive * (1.0 - smoothstep(ext * 0.94, ext, r));
// 세포 하나씩 깜빡이는 반짝임
vec2 gc = floor(p * cells_n * 3.0 + seed * 3.0);
float gh = fr_hash(gc);
glint = step(0.955, gh) * pow(0.5 + 0.5 * sin(clock * 5.0 + gh * 60.0), 6.0) * cover;
"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_878va"]
resource_name = "Rime color"
size = Vector2(520, 360)
expression = "
vec3 col = mix(c_frost.rgb * (0.86 + 0.22 * facet), c_edge.rgb, clamp(crack * 0.75 + rim * 0.55, 0.0, 1.0));
col += vec3(1.0) * glint * 1.2;
col = mix(col, vec3(0.5, 0.66, 0.95), wet * 0.6);
color = col;
alpha = clamp(cover * opacity * (0.5 + 0.2 * facet + 0.35 * crack + 0.3 * rim) + glint * 0.6, 0.0, 1.0);
"

[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_quk6k"]
resource_name = "Frost noise / cells / segment"
expression = "
float fr_hash(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}
float fr_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(fr_hash(i), fr_hash(i + vec2(1.0, 0.0)), f.x),
		mix(fr_hash(i + vec2(0.0, 1.0)), fr_hash(i + vec2(1.0, 1.0)), f.x), f.y);
}
float fr_fbm(vec2 p) {
	float v = 0.0;
	float a = 0.5;
	for (int k = 0; k < 4; k++) {
		v += a * fr_noise(p);
		p = p * 2.03 + vec2(1.7, 9.2);
		a *= 0.5;
	}
	return v;
}
// 결정 세포: x = 가장 가까운 점까지 거리, y = 경계까지 거리(F2-F1), z = 세포 고유값
vec3 fr_cells(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	float id = 0.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 o = vec2(fr_hash(i + g), fr_hash(i + g + 19.7));
			float d = length(g + o - f);
			if (d < d1) {
				d2 = d1;
				d1 = d;
				id = fr_hash(i + g + 3.1);
			} else if (d < d2) {
				d2 = d;
			}
		}
	}
	return vec3(d1, d2 - d1, id);
}
float fr_seg(vec2 p, vec2 a, vec2 b) {
	vec2 pa = p - a;
	vec2 ba = b - a;
	float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * h);
}
"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_a10it"]
input_name = "uv"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_k7cii"]
