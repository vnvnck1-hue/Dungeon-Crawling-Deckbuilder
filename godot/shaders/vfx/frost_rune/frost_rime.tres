[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_7ajeu"]
parameter_name = "opacity"
default_value_enabled = true
default_value = 0.78

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_gw71c"]
parameter_name = "cell_scale"
default_value_enabled = true
default_value = 7.0

[resource]
resource_name = "Frost rune / ground rime / spread + melt"
modes/depth_draw = 2
modes/cull = 2
flags/unshaded = true
flags/shadows_disabled = true
nodes/fragment/0/position = Vector2(900, 0)
nodes/fragment/2/node = SubResource("VisualShaderNodeGlobalExpression_quk6k")
