[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_63kj2"]
resource_name = "Werewolf noise / cracks"
expression = "
float ww_hash(vec2 p) {
	p = fract(p * vec2(127.13, 311.71));
	p += dot(p, p + 41.7);
	return fract(p.x * p.y);
}
float ww_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(ww_hash(i), ww_hash(i + vec2(1.0, 0.0)), f.x),
		mix(ww_hash(i + vec2(0.0, 1.0)), ww_hash(i + vec2(1.0, 1.0)), f.x), f.y);
}
float ww_fbm(vec2 p) {
	float v = 0.0;
	float a = 0.5;
	for (int k = 0; k < 4; k++) {
		v += a * ww_noise(p);
		p = p * 2.07 + vec2(3.1, 7.7);
		a *= 0.5;
	}
	return v;
}
// 가장자리까지 거리(F2-F1) — 균열 선
float ww_crack(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 g = vec2(float(x), float(y));
			vec2 o = vec2(ww_hash(i + g), ww_hash(i + g + 17.3));
			float d = length(g + o - f);
			if (d < d1) { d2 = d1; d1 = d; } else if (d < d2) { d2 = d; }
		}
	}
	return d2 - d1;
}
"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_7iqdl"]
input_name = "uv"

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_c0e27"]
parameter_name = "close"
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_bnnl3"]
parameter_name = "flash"
default_value_enabled = true

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_qf52q"]
parameter_name = "fade"
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_lxoa3"]
parameter_name = "color_fang"
default_value_enabled = true
default_value = Color(1, 0.95, 1, 1)

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_1whvd"]
parameter_name = "color_glow"
default_value_enabled = true
default_value = Color(0.9, 0.3, 0.8, 1)

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_x4xwu"]
resource_name = "Fang jaws"
size = Vector2(520, 360)
expression = "
vec2 p = (uv_in - vec2(0.5)) * 2.0;
p.y = -p.y;
float open = (1.0 - close) * 0.62;
// 턱 윤곽: 위아래 초승달(입 모양으로 휜 띠)
float curve = 0.32 * p.x * p.x;
float jaw_u = p.y - (open + 0.04 - curve);    // 위턱 아래 가장자리 기준
float jaw_l = -(p.y + (open + 0.04 - curve)); // 아래턱 위 가장자리 기준
float span = 1.0 - smoothstep(0.78, 0.92, abs(p.x));
// 송곳니 줄: 톱니(가운데 두 개가 길다)
float n = 7.0;
float cell = fract(p.x * n * 0.5 + 0.5) - 0.5;
float big = 1.0 + 1.1 * (1.0 - smoothstep(0.18, 0.42, abs(p.x)));
float tooth_h = 0.17 * big * (1.0 - abs(cell) * 2.0);
float upper = smoothstep(-0.015, 0.015, jaw_u + tooth_h) * (1.0 - smoothstep(0.1, 0.16, jaw_u));
float lower = smoothstep(-0.015, 0.015, jaw_l + tooth_h * 0.8) * (1.0 - smoothstep(0.1, 0.16, jaw_l));
float fang = max(upper, lower) * span;
float g = exp(-min(abs(jaw_u), abs(jaw_l)) * 9.0) * span;
float flash_ring = exp(-abs(length(p) - 0.35 - flash * 0.4) * 18.0) * flash;
color = c_fang.rgb * fang * 1.4 + c_glow.rgb * g * 0.8 + vec3(1.0, 0.8, 1.0) * flash_ring * 1.6;
alpha = clamp(fang + g * 0.5 + flash_ring, 0.0, 1.0) * fade * (1.0 - smoothstep(0.9, 1.0, length(p)));
"

