[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_5nh4c"]
parameter_name = "color_shade"
default_value_enabled = true
default_value = Color(0.58, 0.68, 0.96, 1)

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_naxxn"]
resource_name = "Swirling sheet"
size = Vector2(520, 360)
expression = "
// uv.x = 둘레(0~1, 이어짐), uv.y = 위(0) → 아래(1). 둘레는 원 위의 점으로 잡음을 뽑아 이음매가 없다.
float a = uv_in.x * 6.28318;
vec2 ring = vec2(cos(a), sin(a));
float h = 1.0 - uv_in.y;
float rise = clock * 1.4 + prog * 3.0;
float n1 = nv_fbm(ring * 2.6 + vec2(h * 2.2 - rise, seed * 3.0));
float n2 = nv_noise(ring * 9.0 + vec2(h * 6.0 - rise * 2.0, seed));
// 아래가 짙고 위로 갈수록 찢겨 흩어진다. 진행할수록 위쪽부터 비어 간다.
float top = smoothstep(1.0, 0.25 + prog * 0.15, h);
float tatter = smoothstep(0.28 + h * 0.38, 0.7, n1 * 0.75 + n2 * 0.38);
dens = tatter * top * smoothstep(0.0, 0.06, h) * 1.2;
tone = n1;
"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_m1fqw"]
resource_name = "Wall color"
size = Vector2(520, 360)
expression = "
col = mix(shade, snow, clamp(tone * 1.4, 0.0, 1.0));
alpha = clamp(dens * intensity * fade, 0.0, 0.75);
"

[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_cukko"]
resource_name = "Nivella snow noise"
expression = "
float nv_hash(vec2 p) {
	p = fract(p * vec2(127.13, 311.71));
	p += dot(p, p + 41.7);
	return fract(p.x * p.y);
}
float nv_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(nv_hash(i), nv_hash(i + vec2(1.0, 0.0)), f.x),
		mix(nv_hash(i + vec2(0.0, 1.0)), nv_hash(i + vec2(1.0, 1.0)), f.x), f.y);
}
float nv_fbm(vec2 p) {
	float v = 0.0;
	float a = 0.5;
	for (int k = 0; k < 4; k++) {
		v += a * nv_noise(p);
		p = p * 2.07 + vec2(3.1, 7.7);
		a *= 0.5;
	}
	return v;
}
"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_ucjea"]
input_name = "uv"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_w8nyr"]
input_name = "time"

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_owm3k"]
parameter_name = "progress"
default_value_enabled = true

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_23k50"]
parameter_name = "fade"
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_glw50"]
parameter_name = "intensity"
default_value_enabled = true
default_value = 0.8

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_ea3bi"]
parameter_name = "seed"
default_value_enabled = true

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_abhuy"]
parameter_name = "color_snow"
default_value_enabled = true
default_value = Color(0.93, 0.96, 1, 1)

[resource]
resource_name = "Nivella / roar / rising snow wall"
modes/depth_draw = 2
modes/cull = 2
flags/unshaded = true
flags/shadows_disabled = true
flags/fog_disabled = true
