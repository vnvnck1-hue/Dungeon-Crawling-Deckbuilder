[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_6kj4h"]
input_name = "uv"

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_jlwov"]
parameter_name = "motion_time"
default_value_enabled = true

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_jslct"]
parameter_name = "reveal"
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_sjhck"]
parameter_name = "opacity"
default_value_enabled = true
default_value = 0.98

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_r5nes"]
resource_name = "Slow cloth / 2 waves"
expression = "
warped = uv_in;
warped.y += 0.018 * sin(uv_in.x * 12.0 + clock * 0.48)
          + 0.009 * sin(uv_in.x * 23.0 - clock * 0.31);
warped.x += 0.007 * sin(uv_in.y * 9.0 + clock * 0.37);
"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_7bxat"]
resource_name = "Soft irregular silhouette"
expression = "
vec2 p = (uv_shape - vec2(0.5)) * vec2(2.4, 1.0);
vec2 q = abs(p) - vec2(1.055, 0.335);
float d = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - 0.108;
float edge = 1.0 - smoothstep(-0.003, 0.003, d);
float wipe = 1.0 - smoothstep(reveal_amount * 1.16 - 0.12, reveal_amount * 1.16, uv_shape.x);
ink_alpha = edge * wipe * alpha;
"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_sieuo"]
resource_name = "Near black violet pigment"
expression = "
float flow = 0.5 + 0.5 * sin(uv_color.x * 5.0 + uv_color.y * 3.0 + clock * 0.22);
ink_color = mix(vec3(0.032, 0.022, 0.049), vec3(0.051, 0.034, 0.073), flow * 0.5);
"

